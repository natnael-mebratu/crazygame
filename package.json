{
  "name": "crazygame",
  "private": true,
  "description": "Crazy — the Ethiopian card game, played online with friends.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:server & npm run dev:web",
    "dev:server": "npm run dev -w @crazy/server",
    "dev:web": "npm run dev -w @crazy/web",
    "build": "npm run build -w @crazy/web",
    "start": "npm run start -w @crazy/server",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "e2e": "node scripts/e2e.mjs"
  }
}
